[
  {
    "icon": "󰐃",
    "category": "Panes",
    "title": "Mark Pane",
    "description": "mark this pane; then Swap With Marked from another",
    "action": { "tmux": "select-pane -m" }
  },
  {
    "icon": "󰓡",
    "category": "Panes",
    "title": "Swap With Marked",
    "description": "swap this pane with the marked one",
    "action": { "tmux": "swap-pane" }
  },
  {
    "icon": "󱂬",
    "category": "Windows",
    "title": "Move Window to Session...",
    "description": "send this window to another session",
    "action": { "palette": "move-window" }
  },
  {
    "icon": "󰒺",
    "category": "Windows",
    "title": "Auto sort window numbers",
    "description": "renumber to close gaps (1-2-4 → 1-2-3)",
    "action": { "tmux": "move-window -r" }
  },
  {
    "icon": "󰬲",
    "category": "Windows",
    "title": "Change current window number",
    "description": "move this window to a chosen index",
    "action": { "tmux": "command-prompt -p 'New window number:' 'move-window -t %%'" }
  },
  {
    "icon": "󰘬",
    "category": "Tools",
    "title": "lazygit",
    "action": { "popup": "lazygit" }
  },
  {
    "icon": "󰆍",
    "category": "Tools",
    "title": "Terminal Popup",
    "description": "shell in the active pane's directory",
    "action": { "tmux": "display-popup -E -d '#{pane_current_path}' -w 80% -h 80%" }
  }
]
