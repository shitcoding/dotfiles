##########################################################################
##### Key Bindings    ####################################################
##########################################################################
# Note:
# `<Prefix>+key`: simultaneously press <Prefix> and key
# `<Prefix> key`: press <Prefix> and then press the key

# Bind <Prefix> to Ctrl+A instead of Ctrl+B 
unbind C-b
set -g prefix C-a

# Use Vim hjkl keys for moving between windows and resizing panes
setw -g mode-keys vi

# Turn on the mouse
setw -g mouse on

# # `<Prefix> hjkl`: switch between panes
bind h select-pane -L
bind j select-pane -D
bind k select-pane -U
bind l select-pane -R

# `<Prefix> ролд` (hjkl in Russian layout): switch between panes
bind р select-pane -L
bind о select-pane -D
bind л select-pane -U
bind д select-pane -R

# `<Alt>+hjkl` (without <Prefix>): switch between panes
# bind -n M-h select-pane -L
# bind -n M-j select-pane -D 
# bind -n M-k select-pane -U
# bind -n M-l select-pane -R

# `<Alt>+z` (without <Prefix>): zoom current pane
bind -n M-z resize-pane -Z

# `<Alt>+Number` (without <Prefix>): Change to window `Number`
bind -n M-1 select-window -t 1
bind -n M-2 select-window -t 2
bind -n M-3 select-window -t 3
bind -n M-4 select-window -t 4
bind -n M-5 select-window -t 5
bind -n M-6 select-window -t 6
bind -n M-7 select-window -t 7
bind -n M-8 select-window -t 8
bind -n M-9 select-window -t 9


# Enter yankee mode (scrollback with line numbers) with `<Ctrl> y`
# Replaces native copy-mode binding — yankee is a superset.
unbind [

# Vim keys in copypaste/yank mode (hjkl, v, y)
set-window-option -g mode-keys vi
bind -T copy-mode-vi v send -X begin-selection
bind -T copy-mode-vi y send -X copy-selection-and-cancel

# Mouse drag-end: do nothing.
# Default is `send -X copy-pipe-and-cancel` which exits copy-mode and clears
# the selection on mouse release. Removing the binding leaves the selection
# visible and selection mode active, so keyboard motions extend the selection
# and `y` (above) is the only thing that writes to the tmux buffer.
unbind -T copy-mode-vi MouseDragEnd1Pane

# Double-click: select word, STAY in copy-mode (don't auto-copy-and-cancel
# 0.3s later — that's what makes the default flash the selection and lose
# it). Override both root (entering copy-mode from a regular pane) and
# copy-mode-vi (already in copy-mode).
bind -T root DoubleClick1Pane \
    select-pane -t = \; \
    if-shell -F "#{||:#{pane_in_mode},#{mouse_any_flag}}" \
        { send-keys -M } \
        { copy-mode -H ; send-keys -X select-word }
bind -T copy-mode-vi DoubleClick1Pane \
    select-pane \; \
    send-keys -X select-word

# Open new panes/splits in current working directory
bind '"' split-window -v -c "#{pane_current_path}"
bind % split-window -h -c "#{pane_current_path}"


# Navigating between windows _______________________________________
unbind n
unbind p

# `Ctrl+Space`: switch to the last active window
bind -n C-Space last-window
# `Ctrl+Option+Space`: switch to the last active session
bind -n C-M-Space switch-client -l        

# # `<Prefix>+h`: select previous window (next to the left)
# bind -r C-h previous-window 
# # `<Prefix>+l`: select next window (next to the right)
# bind -r C-l next-window

# `<Prefix>+k`: move the current window to the left in windows list
bind -r C-k swap-window -t -1 \; previous-window
# `<Prefix>+j`: move the current window to the right in windows list
bind -r C-j swap-window -t +1 \; next-window

# `<Option>+h`: select previous window (next to the left)
bind -n M-h previous-window
# `<Option>+l`: select next window (next to the right)
bind -n M-l next-window
# `<Prefix>+k`: move the current window to the left in windows list
bind -n M-k swap-window -t -1 \; previous-window
# `<Prefix>+j`: move the current window to the right in windows list
bind -n M-j swap-window -t +1 \; next-window 


# Change current window number: `<Prefix> Alt+n`
bind M-n command-prompt -p "Change window number (enter number):"  "move-window -t '%%'"


# Moving panes/windows between windows/sessions ____________________
# Move pane to another window with <Prefix> v
bind v command-prompt -p "Move pane to window (enter window number):"  "join-pane -t :'%%'"

# Send (break) pane to new window with <Prefix> b
bind b break-pane -t :

# Move window to another session with <Prefix> <Alt>+v
bind M-v command-prompt -p "Move window to session (enter session name):"  "move-window -t '%%':"

#____________________________________________________________________

# `<Prefix> r`: reload .tmux.conf config
bind r source-file ~/.tmux.conf \; display -d 500 '~/.tmux.conf sourced'


# `<Prefix> L`: Clear all panes of the current window — send Ctrl-l only to
# shell panes (zsh/bash/tmux), skipping vim/TUI apps. Inlined, no external
# script. ##{...} escapes the format so run-shell passes it through to the
# inner list-panes instead of pre-expanding it to the current pane.
unbind L # Unbind default binding (open last session)
bind L run-shell "tmux list-panes -F '##{pane_id} ##{pane_current_command}' | while read -r p c; do case \$c in zsh|bash|tmux) tmux send-keys -t \$p C-l ;; esac; done"




##########################################################################



##########################################################################
#### General Settings ####################################################
##########################################################################
set -g history-limit 50000   # boost history

set -g base-index 1        # start windows numbering from 1 instead of 0
setw -g pane-base-index 1  # start panes numbering from 1 instead of 0

##########################################################################



##########################################################################
###############   Begin TPM Plugin Manager Settings   ####################
##########################################################################
# List of plugins
set -g @plugin 'tmux-plugins/tpm' # TPM plugin manager

# A set of sensible tmux options
set -g @plugin 'tmux-plugins/tmux-sensible'

# tmux-yankee: vim-flavored copy-mode replacement (superset of tmux-yank).
# Binary is downloaded from the latest GitHub release on first plugin load.
set -g @plugin 'shitcoding/tmux_yankee'

# Save and restore tmux sessions and windows
# `<Prefix> <Ctrl>+s` to save
# `<Prefix> <Ctrl>+r` to restore
set -g @plugin 'tmux-plugins/tmux-resurrect'

# Relaunch Claude Code sessions in their original panes on resurrect restore.
# Hooks into tmux-resurrect's post-save-all / post-restore-all (no continuum needed).
set -g @plugin 'timvw/tmux-assistant-resurrect'

# tmux-fzf
set -g @plugin 'sainnhe/tmux-fzf'

# Command palette (Raycast-style popup). Needs Bun + tmux 3.4+.
# Opened with Cmd+P via Karabiner (Cmd+P → tmux prefix; bound to prefix `p`).
set -g @plugin 'eduwass/tmux-palette'
# MUST be set before 'run tpm' below — the plugin binds its key at load time,
# so if @palette-key isn't 'off' yet it grabs its default C-Space and clobbers
# `bind -n C-Space last-window`. 'off' = we bind prefix p ourselves (see below).
set -g @palette-key 'off'


# Initialize TMUX plugin manager
run '~/.tmux/plugins/tpm/tpm'

# Save/restore in the background: plain run-shell holds every keypress until the
# script exits. Save also runs quiet, because the plugin's spinner calls
# display-message, which freezes all pane output while it shows. Progress goes to
# status-right via @resurrect-busy instead. Restore has no quiet mode, so its
# spinner still freezes output. Must come after TPM, which binds these for the plugin.
bind C-s run-shell -b 'tmux set -g @resurrect-busy "Saving…"; ~/.tmux/plugins/tmux-resurrect/scripts/save.sh quiet; tmux set -g @resurrect-busy "Saved"; sleep 2; tmux set -gu @resurrect-busy'
bind C-r run-shell -b '~/.tmux/plugins/tmux-resurrect/scripts/restore.sh'
##########################################################################
##### End of TPM Plugin Manager Settings             #####################
##########################################################################




##########################################################################
##### Color Scheme Settings (modified Gruvbox theme)     #################
##########################################################################

# window separators
set-option -wg window-status-separator ""

# monitor window changes
set-option -wg monitor-activity on
set-option -wg monitor-bell on

# set statusbar update interval
set-option -g status-interval 1

### colorscheme ######################################################

# change window screen colors
set-option -wg mode-style bg="#fe8019",fg="#262626"

# default statusbar colors (terminal bg should be #282828)
set-option -g status-style bg=terminal,fg="#b0b1ab"

# default window title colors
set-option -wg window-status-style bg="#262626",fg="#7c6f64"

# colors for windows with activity
set-option -wg window-status-activity-style bg="#262626",fg="#b0b1ab"

# colors for windows with bells
set-option -wg window-status-bell-style bg="#262626",fg="#fe8019"

# active window title colors
set-option -wg window-status-current-style bg="#fe8019",fg="#262626"

# pane border
set-option -g pane-active-border-style fg="#fe8019"
set-option -g pane-border-style fg="#262626"
# Heavy lines, and arrows pointing into the active pane instead of the default
# half-coloured border in two-pane windows
set-option -g pane-border-lines heavy
set-option -g pane-border-indicators arrows

# message info. tmux 3.8 only clears the status line under a message when the
# style has fill=, otherwise the window list shows through the message
set-option -g message-style bg="#fe8019",fg="#262626",fill="#fe8019"

# writing commands inactive
set-option -g message-command-style bg="#b0b1ab",fg="#262626",fill="#b0b1ab"

# pane number display
set-option -g display-panes-active-colour "#fe8019"
set-option -g display-panes-colour "#262626"

# clock
set-option -wg clock-mode-colour "#fe8019"

# copy mode highlighting
%if #{>=:#{version},3.2}
    set-option -wg copy-mode-match-style "bg=#b0b1ab,fg=#262626"
    set-option -wg copy-mode-current-match-style "bg=#fe8019,fg=#262626"
%endif

# statusbar formatting
# "#fe8019" MUST be in lowercase here (conflicts with statusline alias otherwise)
set-option -g status-left "#[bg=#b0b1ab, fg=#262626]#{?client_prefix,#[bg=#fe8019],#[bg=#b0b1ab]} #{session_name} "
set-option -g status-right "#{?@resurrect-busy,#[bg=#fe8019#,fg=#262626] #{@resurrect-busy} ,}#[bg=#b0b1ab, fg=#262626]#{?client_prefix,#[bg=#fe8019],#[bg=#b0b1ab]} #{host_short} "

set-option -wg window-status-current-format "#{?window_zoomed_flag,#[fg=default bold],#[fg=default]} #{window_index} #{window_name} "
set-option -wg window-status-format "#{?window_zoomed_flag,#[fg=default bold],#[fg=default]} #{window_index} #{window_name} "


##########################################################################
##### End of Color Scheme Settings      ##################################
##########################################################################



##########################################################################
#####          Begin User installed plugins settings      ################
##########################################################################
# Make tmux-resurrect plugin restore additional programs
set -g @resurrect-processes 'vim nvim lvim htop btop nvitop lazygit'

# tmux-assistant-resurrect cleanup:
# Plugin entrypoint unconditionally sets @continuum-restore + @continuum-save-interval
# (we don't use continuum) and symlinks an OpenCode plugin we don't need. Undo both
# AFTER TPM has loaded — runs once per config source / tmux start.
set -gu @continuum-restore
set -gu @continuum-save-interval
run-shell 'rm -f ~/.config/opencode/plugins/session-tracker.js'



# tmux-yankee settings — values are read by yankee.tmux at plugin load.
# The plugin entry script is re-run below so it sees these settings
# (TPM's initial auto-run at startup happens before this block).
set -g @yankee_key "C-y"
set -g @yankee_key_table "root"
set -g @yankee_wrap_mode "on"
set -g @yankee_mouse "on"
set -g @yankee_bind_H "first_nonblank"
set -g @yankee_bind_L "last_nonblank"
set -g @yankee_scrollback_lines 50000   # capture full history, not just the last 2000 (needs history-limit above)
run-shell '~/.tmux/plugins/tmux_yankee/yankee.tmux'

# tmux-fzf settings
# Info: https://github.com/sainnhe/tmux-fzf
# TMUX_FZF_LAUNCH_KEY="C-f"
# TMUX_FZF_ORDER="keybinding|session|window|pane|command"

# tmux-palette settings
# macOS never delivers Cmd to tmux. Karabiner maps Cmd+P → `Ctrl+A` then `p`
# (the tmux prefix + p), matching the existing Cmd+HJKL tmux-nav rules, so we
# bind the palette to PREFIX p here. (@palette-key 'off' is set ABOVE, before
# 'run tpm', so the plugin never binds its default C-Space over last-window.)
bind p run-shell '~/.tmux/plugins/tmux-palette/bin/tmux-palette.sh'

# Vim nav (Ctrl+J/K + Ctrl+U/D) is an upstream feature now — enabled in
# tmux-palette/navigation.json ("vimKeys": true), not via a tmux option.

##########################################################################
#####          End of User installed plugins settings      ###############
##########################################################################


##########################################################################
#####          Begin Various Fixes      ##################################
##########################################################################
set-option -g focus-events on # fix for vim-numbertoggle Vim plugin

# Advertise 24-bit colour to the outer terminal. Without this tmux quantises every
# truecolor sequence to the 256-colour cube, which silently shifts hues -- e.g.
# #613315 lands on xterm 58 (#5f5f00), brown rendered as olive. default-terminal is
# already tmux-256color, which is correct; only the RGB capability was missing.
# Named per terminal rather than "*:RGB" so a terminal without truecolor is unaffected.
set -as terminal-features ",alacritty:RGB,xterm-ghostty:RGB,xterm-kitty:RGB"

# Name the terminal window after the tmux session, window and pane name
set -g set-titles on
set -g set-titles-string "#S · #W#{?pane_title, · #{pane_title},}"

# Pane names: set with `prefix T` (or tmux-palette's rename pane), searchable in
# tmux-palette's find pane, saved by tmux-resurrect. Programs may not change pane
# titles (zsh and Claude Code would overwrite a name at every prompt), and new
# panes start untitled instead of with the hostname.
setw -g allow-set-title off
set-hook -g after-new-session 'select-pane -T ""'
set-hook -g after-new-window 'select-pane -T ""'
set-hook -g after-split-window 'select-pane -T ""'

##########################################################################
#####          End of Various Fixes      #################################
##########################################################################
